{
  "name": "inspire-music-desktop",
  "version": "1.0.0",
  "description": "Inspire Music Windows Desktop - Liquid Glass Music Player",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "dev:web": "vite",
    "build": "tsc && vite build",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win --dir",
    "dist:portable": "npm run build && electron-builder --win portable"
  },
  "build": {
    "appId": "com.inspiremusic.desktop",
    "productName": "InspireMusic",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "electron/icon.ico",
      "target": [
        "dir"
      ]
    },
    "asar": true
  },
  "keywords": [
    "music-player",
    "apple-music",
    "liquid-glass",
    "electron"
  ],
  "author": "InspireMusic",
  "license": "MIT",
  "dependencies": {
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "electron-builder": "^26.15.3",
    "music-metadata": "^10.8.2",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  }
}
